/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    model = "planck";
    compatible = "yangxing,planck";

    chosen {
        zephyr,code-partition = &code_partition;
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zmk,battery = &vbatt;
    };

    // 独立后每块板 22 键，位置 0-21 按 6/6/6/4 顺序排列（原 RC(0,0)..RC(0,21)）
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <22>;
        rows = <1>;
        map = <
			RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)
			RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11)
			RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16) RC(0,17)
			         RC(0,18) RC(0,19) RC(0,20) RC(0,21)
        >;
    };

    // 物理布局按板旋转，分别定义在 planck_left.dts / planck_right.dts

    vbatt: vbatt {
        compatible = "zmk,battery-nrf-vddh";
    };
	right_encoder: encoder_right {
					compatible = "alps,ec11";
					a-gpios = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
					b-gpios = <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
					status = "disabled";
					steps = <30>;
	 };

	left_encoder: encoder_left {
					compatible = "alps,ec11";
					a-gpios = <&gpio1  2(GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
					b-gpios = <&gpio1  7(GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
					status = "disabled";
					steps = <30>;
	 };
sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder >;
        triggers-per-rotation = <15>;
    };
};

&adc {
    status = "okay";
};
&gpiote {
    status = "okay";
};

&gpio0 {
    status = "okay";
};

&gpio1 {
    status = "okay";
};

zephyr_udc0:&usbd {
		status = "okay";
};



&flash0 {
    /*
     * For more information, see:
     * http://docs.zephyrproject.org/latest/devices/dts/flash_partitions.html
     */
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        sd_partition: partition@0 {
            reg = <0x00000000 0x00026000>;
        };
        code_partition: partition@26000 {
            reg = <0x00026000 0x000c6000>;
        };

        /*
         * The flash starting at 0x000ec000 and ending at
         * 0x000f3fff is reserved for use by the application.
         */

        /*
         * Storage partition will be used by FCB/LittleFS/NVS
         * if enabled.
         */
        storage_partition: partition@ec000 {
            reg = <0x000ec000 0x00008000>;
        };

        boot_partition: partition@f4000 {
            reg = <0x000f4000 0x0000c000>;
        };
    };
};
