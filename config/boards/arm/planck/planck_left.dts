#include "planck.dtsi"
#include <dt-bindings/led/led.h>
#include "leds_left.dtsi"

&left_encoder {
    status = "okay";
};

&sensors {
	sensors = <&left_encoder>;
};

/ {
	chosen {
		zmk,physical-layout = &left_physical_layout;
	};

	// 左板：整体逆时针旋转 90°（4 列 x 6 行）
	left_physical_layout: left_physical_layout {
		compatible = "zmk,physical-layout";
		display-name = "PlanckBoy Left";
		transform = <&default_transform>;
		kscan = <&kscan0>;
		keys  //                     w   h    x    y   rot   rx   ry
			= <&key_physical_attrs 100 100    0  500     0    0    0>
			, <&key_physical_attrs 100 100    0  400     0    0    0>
			, <&key_physical_attrs 100 100    0  300     0    0    0>
			, <&key_physical_attrs 100 100    0  200     0    0    0>
			, <&key_physical_attrs 100 100    0  100     0    0    0>
			, <&key_physical_attrs 100 100    0    0     0    0    0>
			, <&key_physical_attrs 100 100  100  500     0    0    0>
			, <&key_physical_attrs 100 100  100  400     0    0    0>
			, <&key_physical_attrs 100 100  100  300     0    0    0>
			, <&key_physical_attrs 100 100  100  200     0    0    0>
			, <&key_physical_attrs 100 100  100  100     0    0    0>
			, <&key_physical_attrs 100 100  100    0     0    0    0>
			, <&key_physical_attrs 100 100  200  500     0    0    0>
			, <&key_physical_attrs 100 100  200  400     0    0    0>
			, <&key_physical_attrs 100 100  200  300     0    0    0>
			, <&key_physical_attrs 100 100  200  200     0    0    0>
			, <&key_physical_attrs 100 100  200  100     0    0    0>
			, <&key_physical_attrs 100 100  200    0     0    0    0>
			, <&key_physical_attrs 100 100  300  300     0    0    0>
			, <&key_physical_attrs 100 100  300  200     0    0    0>
			, <&key_physical_attrs 100 100  300  100     0    0    0>
			, <&key_physical_attrs 100 100  300    0     0    0    0>
			;
	};
  kscan0: kscan_composite {
		compatible = "zmk,kscan-composite";
		columns =<50>;
        wakeup-source;
		matrix {
			kscan = <&kscan1>;
		};
		encoder {
			kscan = <&kscan2>;
			row-offset=<0>;
			col-offset=<18>;
		};
	};
	kscan1: kscan {
		compatible = "zmk,kscan-gpio-direct";
		wakeup-source;
		input-gpios
			=  <&gpio0  28 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //5
			, <&gpio0  05 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //5
		    , <&gpio0  4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //12
			, <&gpio0  21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //13
            , <&gpio0  19 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> //18
            ,<&gpio0  16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //19
			, <&gpio0  27 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //14
			, <&gpio0  25 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //14
			, <&gpio0  23 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //17
			, <&gpio0	14 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //20
            , <&gpio0  13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> //ex1
            , <&gpio0  15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> //4
			, <&gpio0  30 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> //16
			, <&gpio0  3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //21
            , <&gpio1  12 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> //ex2
			, <&gpio1  11 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //3
		    , <&gpio1  05 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> //6
            , <&gpio1  13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //11
			, <&gpio0 29 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> //2
			, <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //7
			, <&gpio1 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //10
				, <&gpio1 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //15
		;
	};
	kscan2: kscan_encoder {
		compatible = "zmk,kscan-gpio-direct";
		wakeup-source;
		input-gpios
			=  <&gpio0 31 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  //5
		;
	};
};
