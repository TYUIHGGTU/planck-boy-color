#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#include <behaviors/toggle_io.dtsi> // &tog_io 翻转 LED
#include <behaviors/on_io.dtsi>     // &on_io  点亮 LED
#include <behaviors/off_io.dtsi>    // &off_io 熄灭 LED

/ {
    combos {
        compatible = "zmk,combos";

        // 左板三键同时按（上一任务 / ↑ / 下一任务）进入 BLE 管理层
        desk_l_down {
            bindings = <&mo 1>;
            key-positions = <1 7 13>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // WorkBuddy Pad（对照 docs/workbuddy/layout/03-workbuddy-pad.json）
        // 列优先、自下而上：底行 ←↓→，顶行 主窗口/全屏/搜索/停止
        WORKBUDDY {
            bindings = <
/* ←          上一任务      新建对话    @Agent       设置面板      主窗口 */
&kp LEFT      &kp LG(LBKT)  &kp LG(N)   &kp AT       &kp LG(COMMA) &kp LS(LA(W))
/* ↓          ↑             语音输入    /Skills      字号0         展开全屏 */
&kp DOWN      &kp UP        &kp LG(D)   &kp FSLH     &kp LG(N0)    &kp LC(LG(F))
/* →          下一任务      换行输入    左侧目录     字号+         对话搜索 */
&kp RIGHT     &kp LG(RBKT)  &kp LS(RET) &kp LG(B)    &kp LG(EQUAL) &kp LG(F)
/*            发送消息      右侧产物    字号-        停止生成 */
              &kp RET       &kp LS(LG(B)) &kp LG(MINUS) &kp ESC
            >;

            // 旋钮：转 = 字号±（⌘+ / ⌘-）；按与 pos18 同键（发送）
            sensor-bindings = <&inc_dec_kp LG(EQUAL) LG(MINUS)>;

            label = "WORKBUDDY";
        };

        BLE {
            bindings = <
&trans  &trans  &tog_io 0  &trans  &trans  &bt BT_SEL 0
&trans  &trans  &tog_io 1  &trans  &trans  &bt BT_SEL 1
&trans  &trans  &tog_io 2  &trans  &trans  &bt BT_SEL 2
                &bt BT_CLR_ALL  &bt BT_CLR  &trans  &bt BT_SEL 3
            >;

            label = "BLE";
        };
    };
};
